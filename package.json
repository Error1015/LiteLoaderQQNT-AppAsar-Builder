{
  "name": "create_asar",
  "version": "1.0.1",
  "description": "为 QQNT 生成注入 LiteLoader 宿主的 app.asar",
  "main": "build-asar.js",
  "scripts": {
    "build": "node build-asar.js",
    "build:ci": "node build-asar.js --allow-missing-loader --out=dist",
    "deploy": "node install.js",
    "status": "node install.js --status",
    "restore": "node install.js --restore"
  },
  "keywords": [
    "qqnt",
    "liteloaderqqnt",
    "asar",
    "electron"
  ],
