    "type": "git",
    "url": "git+https://github.com/Error1015/LiteLoaderQQNT-AppAsar-Builder.git"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "devDependencies": {
    "@electron/asar": "^4.3.1"
  }
